{
  "policy_id": "structured_mentor_memory_selection_v1",
  "version": "v1",
  "allowed_memory_types": ["case_experience", "ability_strength", "learning_pattern", "mentor_feedback", "remediation_history"],
  "allowed_source_types": ["case_completion", "ability_evidence", "assessment", "remediation_result", "core_lesson_completion"],
  "category_priority": ["unresolved_learning_issue", "course_mentor_feedback", "similar_case_experience", "related_ability_strength", "recent_remediation"],
  "ordering": ["priority_desc", "occurred_at_desc", "memory_id_asc"],
  "default_limit": 3,
  "player_filter_first": true,
  "exclude_current_episode": true,
  "exclude_inactive": true,
  "exclude_deleted": true,
  "requires_embedding": false,
  "uses_similarity": false
}
